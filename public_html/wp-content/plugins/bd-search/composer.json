{
   "require": {
      "algolia/algoliasearch-client-php": "3.3.2",
      "symfony/polyfill-mbstring": "^1.25"
   },
   "require-dev": {
      "phpunit/phpunit": "^9.3",
      "yoast/phpunit-polyfills": "^1.0",
      "brain/monkey": "^2.6"
   },
   "autoload": {
      "psr-4": {
         "BDSearch\\": "src/"
      }
   },
   "autoload-dev": {
      "psr-4": {
         "BDSearch\\Tests\\": "tests/"
      }
   },
   "scripts": {
      "test": "phpunit",
      "test-coverage": "phpunit --coverage-html coverage"
   },
   "config": {
      "optimize-autoloader": true,
      "sort-packages": true
   }
}