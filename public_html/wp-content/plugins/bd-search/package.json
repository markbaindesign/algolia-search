{
   "name": "bd-search-plugin",
   "version": "2.8.1",
   "description": "JavaScript testing for BD Search Algolia plugin",
   "scripts": {
      "test": "jest",
      "test:watch": "jest --watch",
      "test:coverage": "jest --coverage",
      "lint": "eslint assets/js --ext .js",
      "lint:fix": "eslint assets/js --ext .js --fix"
   },
   "devDependencies": {
      "@babel/core": "^7.22.0",
      "@babel/preset-env": "^7.22.0",
      "babel-jest": "^29.5.0",
      "eslint": "^8.42.0",
      "jest": "^29.5.0",
      "jest-environment-jsdom": "^29.5.0",
      "@testing-library/jest-dom": "^5.16.4",
      "@testing-library/dom": "^9.3.0"
   },
   "jest": {
      "testEnvironment": "jsdom",
      "setupFilesAfterEnv": [
         "<rootDir>/tests/js/setup.js"
      ],
      "testMatch": [
         "<rootDir>/tests/js/**/*.test.js",
         "<rootDir>/tests/js/**/*.spec.js"
      ],
      "collectCoverageFrom": [
         "assets/js/custom/**/*.js",
         "!assets/js/vendor/**",
         "!**/node_modules/**"
      ],
      "coverageReporters": [
         "text",
         "lcov",
         "html"
      ],
      "verbose": true
   },
   "babel": {
      "presets": [
         [
            "@babel/preset-env",
            {
               "targets": {
                  "node": "current"
               }
            }
         ]
      ]
   }
}